CP_CI_CLIENT_ID=replace-with-your-client-id
CP_CI_ACCESS_KEY=replace-with-your-access-key

# EU gateway (default). For US, use https://cloudinfra-gw-us.portal.checkpoint.com
CP_CI_GATEWAY=https://cloudinfra-gw.portal.checkpoint.com

# MCP write tools are off by default. Uncomment to enable them for your local session only.
# WRITE_MODE=true
