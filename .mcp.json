{
  "mcpServers": {
    "workforce-ai": {
      "command": "sh",
      "args": [
        "-c",
        "set -a; [ -f ./.env ] && . ./.env; set +a; exec npx --yes @chkp/workforce-ai-mcp@latest"
      ],
      "env": {
        "CP_CI_GATEWAY": "https://cloudinfra-gw.portal.checkpoint.com",
        "WRITE_MODE": "true",
        "MCP_MODE": "stdio"
      }
    }
  }
}
